<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="theatre" name="Theatre API"><mxGraphModel page="0" grid="1" pageWidth="1200" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="play" value="&lt;b&gt;Play&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;title: varchar(255)&lt;br&gt;description: text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="400" y="340" width="250" height="140" as="geometry" /></mxCell><mxCell id="actor" value="&lt;b&gt;Actor&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;first_name: varchar(255)&lt;br&gt;last_name: varchar(255)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="250" height="150" as="geometry" /></mxCell><mxCell id="genre" value="&lt;b&gt;Genre&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;name: varchar(255)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="740" y="40" width="250" height="130" as="geometry" /></mxCell><mxCell id="pa" value="&lt;b&gt;Play actors (automatic join)&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK play_id / actor_id&lt;br&gt;UNIQUE (play_id, actor_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="250" height="140" as="geometry" /></mxCell><mxCell id="pg" value="&lt;b&gt;Play genres (automatic join)&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK play_id / genre_id&lt;br&gt;UNIQUE (play_id, genre_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="740" y="240" width="250" height="140" as="geometry" /></mxCell><mxCell id="hall" value="&lt;b&gt;TheatreHall&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;name: varchar(255)&lt;br&gt;rows: positive integer&lt;br&gt;seats_in_row: positive integer&lt;br&gt;CHECK rows &gt;= 1&lt;br&gt;CHECK seats_in_row &gt;= 1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="740" y="500" width="250" height="220" as="geometry" /></mxCell><mxCell id="performance" value="&lt;b&gt;Performance&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK play_id (PROTECT)&lt;br&gt;FK theatre_hall_id (PROTECT)&lt;br&gt;show_time: datetime" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="250" height="180" as="geometry" /></mxCell><mxCell id="ticket" value="&lt;b&gt;Ticket&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;row / seat: positive integer&lt;br&gt;FK performance_id (PROTECT)&lt;br&gt;FK reservation_id (CASCADE)&lt;br&gt;UNIQUE (row, seat, performance_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="400" y="850" width="290" height="200" as="geometry" /></mxCell><mxCell id="reservation" value="&lt;b&gt;Reservation&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;created_at: datetime (auto)&lt;br&gt;FK user_id (CASCADE)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="250" height="160" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;User (Django auth_user)&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;username / password hash&lt;br&gt;email / first_name / last_name&lt;br&gt;is_staff / is_active / is_superuser&lt;br&gt;last_login / date_joined&lt;br&gt;Standard auth model; auth joins omitted" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="250" height="230" as="geometry" /></mxCell><mxCell id="e0" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="actor" target="pa"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="play" target="pa"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="genre" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="play" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="play" target="performance"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="hall" target="performance"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="performance" target="ticket"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="user" target="reservation"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#526777;fontSize=13;" edge="1" parent="1" source="reservation" target="ticket"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Rules and computed values&lt;/b&gt;&lt;hr&gt;Ticket seat bounds: model/API validation.&lt;br&gt;tickets_available = rows * seats_in_row - ticket count.&lt;br&gt;Computed for each performance; no database column." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#eaf2fa;strokeColor=#4472a0;" vertex="1" parent="1"><mxGeometry x="740" y="850" width="330" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>